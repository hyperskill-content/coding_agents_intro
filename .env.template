# Workshop environment. Copy, fill in, then load it into your shell:
#
#   cp .env.template .env
#   source .env            # in every new terminal, before running your coding agent or agent.py
#
# Keep .env in this folder, never inside playground/: from spec 4 on, your agent
# can read (and leak) anything in its workspace.

# --- Required: values from your instructor ---------------------------------
export OPENAI_BASE_URL="https://…/v1"     # must end in /v1
export OPENAI_API_KEY="sk-…"
export MODEL="kimi-k2.7-code-highspeed"                          

# --- No API? Use the offline mock instead (uv run tools/mock_server.py &) --
# export OPENAI_BASE_URL="http://127.0.0.1:8765/v1"
# export OPENAI_API_KEY="mock"
# export MODEL="mock"

# --- Optional -----------------------------------------------------------------
# Spec 5: folder the file tools are jailed to (default: current directory)
# export WORKSPACE="$PWD/playground"

# Spec 6: sandbox settings
# export SANDBOX="off"                    # run shell commands locally, no Docker
# export SANDBOX_IMAGE="python:3.14-slim"
# export SANDBOX_AUTO_APPROVE="1"         # auto-approve run_shell inside the sandbox

# Spec 7: repo to explore and the pretend context window (tokens)
# export REPO="$HOME/django"
# export CONTEXT_BUDGET="16000"
